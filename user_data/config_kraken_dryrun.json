{
    "_comment": "Phase 4 — production-ready Kraken Pro DRY-RUN for WolfQuantEdge. Separate port (8082) and DB so it never touches the two live bots. stoploss/trailing/ROI are intentionally OMITTED here so the STRATEGY's own (Phase-3-validated) values apply. The slippage mixin is auto-disabled outside backtest, so this runs on real Kraken order-book pricing — which the companion kraken_fill_audit.py then compares against the backtest model.",

    "max_open_trades": 10,
    "stake_currency": "EUR",
    "stake_amount": 75,
    "tradable_balance_ratio": 0.99,
    "fiat_display_currency": "EUR",
    "dry_run": true,
    "dry_run_wallet": 1500,
    "cancel_open_orders_on_exit": false,
    "timeframe": "1h",

    "trading_mode": "spot",
    "margin_mode": "",

    "unfilledtimeout": { "entry": 10, "exit": 10, "exit_timeout_count": 0, "unit": "minutes" },

    "entry_pricing": {
        "price_side": "other",
        "use_order_book": true,
        "order_book_top": 1,
        "price_last_balance": 0.0,
        "check_depth_of_market": { "enabled": false, "bids_to_ask_delta": 1 }
    },
    "exit_pricing": { "price_side": "other", "use_order_book": true, "order_book_top": 1 },

    "order_types": {
        "entry": "market",
        "exit": "market",
        "emergency_exit": "market",
        "force_entry": "market",
        "force_exit": "market",
        "stoploss": "market",
        "stoploss_on_exchange": false
    },

    "exchange": {
        "name": "kraken",
        "key": "",
        "secret": "",
        "ccxt_config": { "enableRateLimit": true },
        "ccxt_async_config": { "enableRateLimit": true },
        "pair_whitelist": [
            "AAVE/EUR", "ADA/EUR", "ARB/EUR", "BTC/EUR", "ETH/EUR", "FET/EUR",
            "HBAR/EUR", "INJ/EUR", "KAS/EUR", "LINK/EUR", "NEAR/EUR", "OP/EUR",
            "POL/EUR", "RENDER/EUR", "SOL/EUR", "STX/EUR", "SUI/EUR", "TIA/EUR"
        ],
        "pair_blacklist": []
    },

    "pairlists": [ { "method": "StaticPairList" } ],

    "telegram": { "enabled": false, "token": "", "chat_id": "" },

    "api_server": {
        "enabled": true,
        "listen_ip_address": "0.0.0.0",
        "listen_port": 8080,
        "verbosity": "error",
        "enable_openapi": false,
        "jwt_secret_key": "",
        "ws_token": "",
        "CORS_origins": ["http://192.168.2.4", "http://192.168.2.4:80"],
        "username": "",
        "password": ""
    },

    "bot_name": "WolfQuantEdge (sim)",
    "initial_state": "running",
    "force_entry_enable": false,
    "internals": { "process_throttle_secs": 5 }
}
