    1:     def test_pure_gaussian_noise_false_breakout_rejection(self):
               """
               Pure Gaussian random walk without structural trend or volume surge must
               strongly suppress entry signals (< 3% false triggers over 1000 candles).
               """
    1:         rng = np.random.default_rng(888)
    1:         n_bars = 1000
               # Pure uncoordinated random noise
    1:         prices = 100.0 + np.cumsum(rng.normal(0, 0.5, size=n_bars))
    1:         prices = np.clip(prices, 50.0, 200.0)
       
    2:         df = pd.DataFrame({
    1:             "date": pd.date_range("2025-01-01", periods=n_bars, freq="1h", tz="UTC"),
    1:             "open": prices,
    1:             "high": prices + rng.uniform(0.01, 0.5, size=n_bars),
    1:             "low": prices - rng.uniform(0.01, 0.5, size=n_bars),
    1:             "close": prices + rng.normal(0, 0.2, size=n_bars),
    1:             "volume": rng.uniform(100.0, 500.0, size=n_bars),  # Flat volume noise
               })
       
    1:         ind = self.strategy.populate_indicators(df, self.metadata)
    1:         entry = self.strategy.populate_entry_trend(ind, self.metadata)
       
               # Evaluate after warmup
    1:         valid_entries = entry.loc[250:, "enter_long"].sum()
    1:         total_eval_bars = len(entry) - 250
    1:         entry_rate = valid_entries / total_eval_bars
       
    2:         self.assertLess(entry_rate, 0.03,
    1:                         f"Excessive false breakout entries on pure Gaussian noise ({entry_rate:.2%})!")
       
    1:     def test_massive_gap_up_mechanics(self):
               """
               A massive +50% overnight gap must calculate Parkinson volatility, expand Donchian on t+1,
               and not corrupt numerical stability.
               """
    1:         df = generate_synthetic_ohlcv(n_bars=100, seed=99)
    1:         gap_idx = 60
       
               # Create massive +50% gap
    1:         pre_gap_close = df.loc[gap_idx - 1, "close"]
    1:         df.loc[gap_idx, "open"] = pre_gap_close * 1.50
    1:         df.loc[gap_idx, "high"] = pre_gap_close * 1.55
    1:         df.loc[gap_idx, "low"] = pre_gap_close * 1.48
    1:         df.loc[gap_idx, "close"] = pre_gap_close * 1.52
    1:         df.loc[gap_idx, "volume"] = df.loc[gap_idx - 1, "volume"] * 5.0
       
    1:         ind = self.strategy.populate_indicators(df, self.metadata)
       
               # On the gap candle (t=60), donchian_high must still reflect pre-gap level (shift 1)
    1:         self.assertLess(ind.loc[gap_idx, "donchian_high"], pre_gap_close * 1.20)
               # On candle t=61, donchian_high must update to include the gap candle's high
    1:         self.assertAlmostEqual(ind.loc[gap_idx + 1, "donchian_high"], pre_gap_close * 1.55)
       
               # Parkinson volatility should remain finite and positive
    1:         self.assertFalse(np.isnan(ind.loc[gap_idx, "pvr"]))
    1:         self.assertFalse(np.isinf(ind.loc[gap_idx, "pvr"]))
    1:         self.assertGreater(ind.loc[gap_idx, "pvr"], 0.0)
       
    1:     def test_massive_gap_down_flash_crash(self):
               """
               A severe -50% flash crash must IMMEDIATELY trigger exit_long and NEVER trigger enter_long.
               """
    1:         df = generate_synthetic_ohlcv(n_bars=100, seed=100)
    1:         crash_idx = 60
       
    1:         pre_close = df.loc[crash_idx - 1, "close"]
    1:         df.loc[crash_idx, "open"] = pre_close * 0.50
    1:         df.loc[crash_idx, "high"] = pre_close * 0.52
    1:         df.loc[crash_idx, "low"] = pre_close * 0.45
    1:         df.loc[crash_idx, "close"] = pre_close * 0.48
    1:         df.loc[crash_idx, "volume"] = 10000.0
       
    1:         ind = self.strategy.populate_indicators(df, self.metadata)
    1:         entry = self.strategy.populate_entry_trend(ind, self.metadata)
    1:         exit_df = self.strategy.populate_exit_trend(ind, self.metadata)
       
    2:         self.assertEqual(entry.loc[crash_idx, "enter_long"], 0,
    1:                          "Entry triggered during catastrophic flash crash!")
    2:         self.assertEqual(exit_df.loc[crash_idx, "exit_long"], 1,
    1:                          "Failed to trigger exit signal during catastrophic flash crash!")
       
    1:     def test_extreme_candle_amplitude_parkinson_variance(self):
