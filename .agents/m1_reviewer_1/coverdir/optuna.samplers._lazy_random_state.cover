    1: from __future__ import annotations
       
    1: import numpy as np
       
       
    2: class LazyRandomState:
    1:     """Lazy Random State class.
       
       
           This is a class to initialize the random state just before use to prevent
           duplication of the same random state when deepcopy is applied to the instance of sampler.
           """
       
    1:     def __init__(self, seed: int | None = None) -> None:
>>>>>>         self._rng: np.random.RandomState | None = None
>>>>>>         if seed is not None:
>>>>>>             self.rng.seed(seed=seed)
       
    1:     def _set_rng(self) -> None:
>>>>>>         self._rng = np.random.RandomState()
       
    2:     @property
    2:     def rng(self) -> np.random.RandomState:
>>>>>>         if self._rng is None:
>>>>>>             self._set_rng()
>>>>>>         assert self._rng is not None
>>>>>>         return self._rng
