    1:                     "description": "IP address the API server listens on.",
    1:                     "format": "ipv4",
                       },
    2:                 "listen_port": {
    1:                     "description": "Port the API server listens on.",
    1:                     "type": "integer",
    1:                     "minimum": 1024,
    1:                     "maximum": 65535,
                       },
    2:                 "username": {
    1:                     "description": "Username for API server authentication.",
