    1:                         {"Exchange": "{exchange}"},
    1:                         {"Pair": "{pair}"},
    1:                         {"Direction": "{direction}"},
    1:                         {"Open rate": "{open_rate}"},
    1:                         {"Amount": "{amount}"},
    1:                         {"Open date": "{open_date:%Y-%m-%d %H:%M:%S}"},
    1:                         {"Enter tag": "{enter_tag}"},
    1:                         {"Strategy": "{strategy} {timeframe}"},
                           ],
                       },
                   },
               },
    2:         "api_server": {
    1:             "description": "API server settings.",
    1:             "type": "object",
    2:             "properties": {
    1:                 "enabled": {"description": "Whether the API server is enabled.", "type": "boolean"},
