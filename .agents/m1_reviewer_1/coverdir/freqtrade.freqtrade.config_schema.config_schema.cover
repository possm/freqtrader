                       },
    2:                 "password": {
    1:                     "description": "Password for API server authentication.",
    1:                     "type": "string",
                       },
    2:                 "ws_token": {
    1:                     "description": "WebSocket token for API server.",
    1:                     "type": ["string", "array"],
    1:                     "items": {"type": "string"},
                       },
    2:                 "jwt_secret_key": {
    1:                     "description": "Secret key for JWT authentication.",
    1:                     "type": "string",
    1:                     "default": "somethingRandomSomethingRandom123",
    1:                     "minLength": 32,
                       },
    2:                 "CORS_origins": {
    1:                     "description": "List of allowed CORS origins.",
    1:                     "type": "array",
    1:                     "items": {"type": "string"},
                       },
    2:                 "verbosity": {
    1:                     "description": "Logging verbosity level.",
    1:                     "type": "string",
    1:                     "enum": ["error", "info"],
                       },
                   },
    1:             "required": [
                       "enabled",
                       "listen_ip_address",
                       "listen_port",
                       "username",
                       "password",
                       "jwt_secret_key",
                   ],
               },
               # end of RPC section
    2:         "db_url": {
    1:             "description": "Database connection URL.",
    1:             "type": "string",
               },
    2:         "export": {
    1:             "description": "Type of data to export.",
    1:             "type": "string",
    1:             "enum": EXPORT_OPTIONS,
    1:             "default": "trades",
               },
    2:         "disableparamexport": {
    1:             "description": "Disable parameter export.",
    1:             "type": "boolean",
               },
    2:         "initial_state": {
    1:             "description": "Initial state of the system.",
    1:             "type": "string",
    1:             "enum": ["running", "paused", "stopped"],
               },
    2:         "force_entry_enable": {
    1:             "description": "Force enable entry.",
    1:             "type": "boolean",
               },
    2:         "disable_dataframe_checks": {
    1:             "description": "Disable checks on dataframes.",
    1:             "type": "boolean",
               },
    2:         "internals": {
    1:             "description": "Internal settings.",
    1:             "type": "object",
    1:             "default": {},
    2:             "properties": {
    2:                 "process_throttle_secs": {
    1:                     "description": "Minimum loop duration for one bot iteration in seconds.",
    1:                     "type": "integer",
                       },
    2:                 "interval": {
    1:                     "description": "Interval time in seconds.",
    1:                     "type": "integer",
                       },
    2:                 "sd_notify": {
    1:                     "description": "Enable systemd notify.",
    1:                     "type": "boolean",
                       },
                   },
               },
    2:         "dataformat_ohlcv": {
    1:             "description": "Data format for OHLCV data.",
    1:             "type": "string",
    1:             "enum": AVAILABLE_DATAHANDLERS,
    1:             "default": "feather",
               },
    2:         "dataformat_trades": {
    1:             "description": "Data format for trade data.",
    1:             "type": "string",
    1:             "enum": AVAILABLE_DATAHANDLERS,
    1:             "default": "feather",
               },
    2:         "position_adjustment_enable": {
    1:             "description": f"Enable position adjustment. {__IN_STRATEGY}",
    1:             "type": "boolean",
               },
               # Download data section
    2:         "new_pairs_days": {
    1:             "description": "Download data of new pairs for given number of days",
    1:             "type": "integer",
    1:             "default": 30,
               },
    2:         "download_trades": {
    1:             "description": "Download trades data by default (instead of ohlcv data).",
    1:             "type": "boolean",
               },
    2:         "max_entry_position_adjustment": {
    1:             "description": f"Maximum entry position adjustment allowed. {__IN_STRATEGY}",
    1:             "type": ["integer", "number"],
    1:             "minimum": -1,
               },
    2:         "add_config_files": {
    1:             "description": "Additional configuration files to load.",
    1:             "type": "array",
    1:             "items": {"type": "string"},
               },
    2:         "orderflow": {
    1:             "description": "Settings related to order flow.",
    1:             "type": "object",
    2:             "properties": {
    2:                 "cache_size": {
    1:                     "description": "Size of the cache for order flow data.",
    1:                     "type": "number",
    1:                     "minimum": 1,
    1:                     "default": 1500,
                       },
    2:                 "max_candles": {
    1:                     "description": "Maximum number of candles to consider.",
    1:                     "type": "number",
    1:                     "minimum": 1,
    1:                     "default": 1500,
                       },
    2:                 "scale": {
    1:                     "description": "Scale factor for order flow data.",
    1:                     "type": "number",
    1:                     "minimum": 0.0,
                       },
    2:                 "stacked_imbalance_range": {
    1:                     "description": "Range for stacked imbalance.",
    1:                     "type": "number",
    1:                     "minimum": 0,
                       },
    2:                 "imbalance_volume": {
    1:                     "description": "Volume threshold for imbalance.",
    1:                     "type": "number",
    1:                     "minimum": 0,
                       },
    2:                 "imbalance_ratio": {
    1:                     "description": "Ratio threshold for imbalance.",
    1:                     "type": "number",
    1:                     "minimum": 0.0,
                       },
                   },
    1:             "required": [
                       "max_candles",
                       "scale",
                       "stacked_imbalance_range",
                       "imbalance_volume",
                       "imbalance_ratio",
                   ],
               },
           },
    2:     "definitions": {
    2:         "exchange": {
    1:             "description": "Exchange configuration settings.",
    1:             "type": "object",
   19:             "properties": {
    1:                 "name": {"description": "Name of the exchange.", "type": "string"},
    2:                 "api_key": {
    1:                     "description": (
    1:                         f"API key for the exchange. {__VIA_ENV} FREQTRADE__EXCHANGE__API_KEY"
                           ),
    1:                     "type": ["string", "null"],
                       },
    2:                 "key": {
    1:                     "description": (
    1:                         f"API key for the exchange. {__VIA_ENV} FREQTRADE__EXCHANGE__KEY"
                               " Deprecated, use api_key instead."
                           ),
    1:                     "type": ["string", "null"],
                       },
    2:                 "secret": {
    1:                     "description": (
    1:                         f"API secret for the exchange. {__VIA_ENV} FREQTRADE__EXCHANGE__SECRET"
                           ),
    1:                     "type": ["string", "null"],
    1:                     "default": None,
                       },
    2:                 "password": {
    1:                     "description": (
    2:                         "Password for the exchange, if required. "
    1:                         f"{__VIA_ENV} FREQTRADE__EXCHANGE__PASSWORD"
                           ),
    1:                     "type": ["string", "null"],
    1:                     "default": None,
                       },
    2:                 "uid": {
    1:                     "description": (
    2:                         "User ID for the exchange, if required. "
    1:                         f"{__VIA_ENV} FREQTRADE__EXCHANGE__UID"
                           ),
    1:                     "type": ["string", "null"],
                       },
    2:                 "account_id": {
    1:                     "description": (
    2:                         "Account ID for the exchange, if required. "
    1:                         f"{__VIA_ENV} FREQTRADE__EXCHANGE__ACCOUNT_ID"
                           ),
    1:                     "type": ["string", "null"],
                       },
    2:                 "wallet_address": {
    1:                     "description": (
    2:                         "Wallet address for the exchange, if required. "
                               "Usually used by DEX exchanges. "
    1:                         f"{__VIA_ENV} FREQTRADE__EXCHANGE__WALLET_ADDRESS"
                           ),
    1:                     "type": ["string", "null"],
                       },
    2:                 "private_key": {
    1:                     "description": (
    2:                         "Private key for the exchange, if required. Usually used by DEX exchanges. "
    1:                         f"{__VIA_ENV} FREQTRADE__EXCHANGE__PRIVATE_KEY"
                           ),
    1:                     "type": ["string", "null"],
                       },
    2:                 "pair_whitelist": {
    1:                     "description": "List of whitelisted trading pairs.",
    1:                     "type": "array",
    1:                     "items": {"type": "string"},
    1:                     "uniqueItems": True,
                       },
    2:                 "pair_blacklist": {
    1:                     "description": "List of blacklisted trading pairs.",
    1:                     "type": "array",
    1:                     "items": {"type": "string"},
    1:                     "uniqueItems": True,
                       },
    2:                 "log_responses": {
    1:                     "description": (
    1:                         "Log responses from the exchange."
                               "Useful/required to debug issues with order processing."
                           ),
    1:                     "type": "boolean",
    1:                     "default": False,
                       },
    2:                 "enable_ws": {
    1:                     "description": "Enable WebSocket connections to the exchange.",
    1:                     "type": "boolean",
    1:                     "default": True,
                       },
    2:                 "unknown_fee_rate": {
    1:                     "description": "Fee rate for unknown markets.",
    1:                     "type": "number",
                       },
    2:                 "outdated_offset": {
    1:                     "description": "Offset for outdated data in minutes.",
    1:                     "type": "integer",
    1:                     "minimum": 1,
                       },
    2:                 "markets_refresh_interval": {
    1:                     "description": "Interval for refreshing market data in minutes.",
    1:                     "type": "integer",
    1:                     "default": 60,
                       },
    1:                 "ccxt_config": {"description": "CCXT configuration settings.", "type": "object"},
    2:                 "ccxt_async_config": {
    1:                     "description": (
    1:                         "CCXT asynchronous configuration settings."
                               "Usually ccxt_config should be used instead."
                           ),
    1:                     "type": "object",
                       },
    2:                 "ccxt_sync_config": {
    1:                     "description": (
    1:                         "CCXT synchronous configuration settings. "
                               "Usually ccxt_config should be used instead."
                           ),
    1:                     "type": "object",
                       },
                   },
    1:             "required": ["name"],
               },
    2:         "logging": {
    1:             "type": "object",
    2:             "properties": {
    1:                 "version": {"type": "number", "const": 1},
    2:                 "formatters": {
    1:                     "type": "object",
                           # In theory the below, but can be more flexible
                           # based on logging.config documentation
                           # "additionalProperties": {
                           #     "type": "object",
                           #     "properties": {
                           #         "format": {"type": "string"},
                           #         "datefmt": {"type": "string"},
                           #     },
                           #     "required": ["format"],
                           # },
                       },
    1:                 "handlers": {"type": "object"},
    1:                 "root": {"type": "object"},
                   },
    1:             "required": ["version", "formatters", "handlers", "root"],
               },
    2:         "external_message_consumer": {
    1:             "description": "Configuration for external message consumer.",
    1:             "type": "object",
    2:             "properties": {
    2:                 "enabled": {
    1:                     "description": "Whether the external message consumer is enabled.",
    1:                     "type": "boolean",
    1:                     "default": False,
                       },
    2:                 "producers": {
    1:                     "description": "List of producers for the external message consumer.",
    1:                     "type": "array",
    2:                     "items": {
    1:                         "type": "object",
    2:                         "properties": {
    2:                             "name": {
    1:                                 "description": "Name of the producer.",
    1:                                 "type": "string",
                                   },
    2:                             "host": {
    1:                                 "description": "Host of the producer.",
    1:                                 "type": "string",
                                   },
    2:                             "port": {
    1:                                 "description": "Port of the producer.",
    1:                                 "type": "integer",
    1:                                 "default": 8080,
    1:                                 "minimum": 0,
    1:                                 "maximum": 65535,
                                   },
    2:                             "secure": {
    1:                                 "description": "Whether to use SSL to connect to the producer.",
    1:                                 "type": "boolean",
    1:                                 "default": False,
                                   },
    2:                             "ws_token": {
    1:                                 "description": "WebSocket token for the producer.",
    1:                                 "type": "string",
                                   },
                               },
    1:                         "required": ["name", "host", "ws_token"],
                           },
                       },
    2:                 "wait_timeout": {
    1:                     "description": "Wait timeout in seconds.",
    1:                     "type": "integer",
    1:                     "minimum": 0,
                       },
    2:                 "sleep_time": {
    1:                     "description": "Sleep time in seconds before retrying to connect.",
    1:                     "type": "integer",
    1:                     "minimum": 0,
                       },
    2:                 "ping_timeout": {
    1:                     "description": "Ping timeout in seconds.",
    1:                     "type": "integer",
    1:                     "minimum": 0,
                       },
    2:                 "remove_entry_exit_signals": {
    1:                     "description": "Remove signal columns from the dataframe (set them to 0)",
    1:                     "type": "boolean",
    1:                     "default": False,
                       },
    2:                 "initial_candle_limit": {
    1:                     "description": "Initial candle limit.",
    1:                     "type": "integer",
    1:                     "minimum": 0,
    1:                     "maximum": 1500,
    1:                     "default": 1500,
                       },
    2:                 "message_size_limit": {
    1:                     "description": "Message size limit in megabytes.",
    1:                     "type": "integer",
    1:                     "minimum": 1,
    1:                     "maximum": 20,
    1:                     "default": 8,
                       },
                   },
    1:             "required": ["producers"],
               },
    2:         "freqai": {
    1:             "type": "object",
   19:             "properties": {
    2:                 "enabled": {
    1:                     "description": "Whether freqAI is enabled.",
    1:                     "type": "boolean",
    1:                     "default": False,
                       },
    2:                 "identifier": {
    1:                     "description": (
    1:                         "A unique ID for the current model. "
                               "Must be changed when modifying features."
                           ),
    1:                     "type": "string",
    1:                     "default": "example",
                       },
    2:                 "write_metrics_to_disk": {
    1:                     "description": "Write metrics to disk?",
    1:                     "type": "boolean",
    1:                     "default": False,
                       },
    2:                 "purge_old_models": {
    1:                     "description": "Number of models to keep on disk.",
    1:                     "type": ["boolean", "number"],
    1:                     "default": 2,
                       },
    2:                 "conv_width": {
    1:                     "description": "The width of a neural network input tensor.",
    1:                     "type": "integer",
    1:                     "default": 1,
                       },
    2:                 "train_period_days": {
    1:                     "description": (
    1:                         "Number of days to use for the training data (width of the sliding window)"
                           ),
    1:                     "type": "integer",
    1:                     "default": 0,
                       },
    2:                 "backtest_period_days": {
    1:                     "description": (
    1:                         "Number of days to inference from the trained model before sliding the "
                               "`train_period_days` window "
                           ),
    1:                     "type": "number",
    1:                     "default": 7,
                       },
    2:                 "live_retrain_hours": {
    1:                     "description": "Frequency of retraining during dry/live runs.",
    1:                     "type": "number",
    1:                     "default": 0,
                       },
    2:                 "expiration_hours": {
    1:                     "description": (
    1:                         "Avoid making predictions if a model is more than `expiration_hours` "
                               "old. Defaults to 0 (no expiration)."
                           ),
    1:                     "type": "number",
    1:                     "default": 0,
                       },
    2:                 "save_backtest_models": {
    1:                     "description": "Save models to disk when running backtesting.",
    1:                     "type": "boolean",
    1:                     "default": False,
                       },
    2:                 "fit_live_predictions_candles": {
    1:                     "description": (
    1:                         "Number of historical candles to use for computing target (label) "
                               "statistics from prediction data, instead of from the training dataset."
                           ),
    1:                     "type": "integer",
                       },
    2:                 "data_kitchen_thread_count": {
    1:                     "description": (
    1:                         "Designate the number of threads you want to use for data processing "
                               "(outlier methods, normalization, etc.)."
                           ),
    1:                     "type": "integer",
                       },
    2:                 "activate_tensorboard": {
    1:                     "description": "Indicate whether or not to activate tensorboard",
    1:                     "type": "boolean",
    1:                     "default": True,
                       },
    2:                 "wait_for_training_iteration_on_reload": {
    1:                     "description": (
    1:                         "Wait for the next training iteration to complete after /reload or ctrl+c."
                           ),
    1:                     "type": "boolean",
    1:                     "default": True,
                       },
    2:                 "continual_learning": {
    1:                     "description": (
    1:                         "Use the final state of the most recently trained model "
                               "as starting point for the new model, allowing for "
                               "incremental learning."
                           ),
    1:                     "type": "boolean",
    1:                     "default": False,
                       },
    2:                 "keras": {
    1:                     "description": "Use Keras for model training.",
    1:                     "type": "boolean",
    1:                     "default": False,
                       },
    2:                 "override_exchange_check": {
    1:                     "description": (
    1:                         "Override the exchange check to force FreqAI to use exchanges "
                               "that may not have enough historic data. Turn this to True if "
                               "you know your FreqAI model and strategy do not require historical data."
                           ),
    1:                     "type": "boolean",
    1:                     "default": False,
                       },
    2:                 "feature_parameters": {
    1:                     "description": "The parameters used to engineer the feature set",
    1:                     "type": "object",
    2:                     "properties": {
    2:                         "include_corr_pairlist": {
    1:                             "description": "List of correlated pairs to include in the features.",
    1:                             "type": "array",
                               },
    2:                         "include_timeframes": {
    1:                             "description": (
    1:                                 "A list of timeframes that all indicators in "
                                       "`feature_engineering_expand_*()` will be created for."
                                   ),
    1:                             "type": "array",
                               },
    2:                         "label_period_candles": {
    1:                             "description": (
    1:                                 "Number of candles into the future to use for labeling the period."
                                       "This can be used in `set_freqai_targets()`."
                                   ),
    1:                             "type": "integer",
                               },
    2:                         "include_shifted_candles": {
    1:                             "description": (
    1:                                 "Add features from previous candles to subsequent candles with "
                                       "the intent of adding historical information."
                                   ),
    1:                             "type": "integer",
    1:                             "default": 0,
                               },
    2:                         "DI_threshold": {
    1:                             "description": (
    1:                                 "Activates the use of the Dissimilarity Index for "
                                       "outlier detection when set to > 0."
                                   ),
    1:                             "type": "number",
    1:                             "default": 0,
                               },
    2:                         "weight_factor": {
    1:                             "description": (
    1:                                 "Weight training data points according to their recency."
                                   ),
    1:                             "type": "number",
    1:                             "default": 0,
                               },
    2:                         "principal_component_analysis": {
    1:                             "description": (
    1:                                 "Automatically reduce the dimensionality of the data set using "
                                       "Principal Component Analysis"
                                   ),
    1:                             "type": "boolean",
    1:                             "default": False,
                               },
    2:                         "indicator_periods_candles": {
    1:                             "description": (
    1:                                 "Time periods to calculate indicators for. "
                                       "The indicators are added to the base indicator dataset."
                                   ),
    1:                             "type": "array",
    1:                             "items": {"type": "number", "minimum": 1},
                               },
