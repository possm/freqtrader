    1:     def __init__(
               self,
>>>>>>         loop: asyncio.AbstractEventLoop,
>>>>>>         timeout: float | None,
>>>>>>         ceil_threshold: float = 5,
>>>>>>     ) -> None:
>>>>>>         self._timeout = timeout
>>>>>>         self._loop = loop
>>>>>>         self._ceil_threshold = ceil_threshold
>>>>>>         self._callbacks: list[
