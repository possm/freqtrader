    1: """
       Payload implementation for coroutines as data provider.
       
       As a simple case, you can upload data from file::
       
          @aiohttp.streamer
          async def file_sender(writer, file_name=None):
             with open(file_name, 'rb') as f:
                 chunk = f.read(2**16)
                 while chunk:
                     await writer.write(chunk)
       
                     chunk = f.read(2**16)
       
       Then you can use `file_sender` like this:
       
           async with session.post('http://httpbin.org/post',
                                   data=file_sender(file_name='huge_file')) as resp:
               print(await resp.text())
       
       ..note:: Coroutine must accept `writer` as first argument
       
       """
       
    1: import types
    1: import warnings
    1: from collections.abc import Awaitable, Callable
    1: from typing import Any
       
    1: from .abc import AbstractStreamWriter
    1: from .payload import Payload, payload_type
       
    1: __all__ = ("streamer",)
       
       
    2: class _stream_wrapper:
    1:     def __init__(
               self,
>>>>>>         coro: Callable[..., Awaitable[None]],
>>>>>>         args: tuple[Any, ...],
>>>>>>         kwargs: dict[str, Any],
>>>>>>     ) -> None:
>>>>>>         self.coro = types.coroutine(coro)
>>>>>>         self.args = args
>>>>>>         self.kwargs = kwargs
       
    1:     async def __call__(self, writer: AbstractStreamWriter) -> None:
>>>>>>         await self.coro(writer, *self.args, **self.kwargs)
       
       
    2: class streamer:
    1:     def __init__(self, coro: Callable[..., Awaitable[None]]) -> None:
>>>>>>         warnings.warn(
>>>>>>             "@streamer is deprecated, use async generators instead",
>>>>>>             DeprecationWarning,
>>>>>>             stacklevel=2,
               )
>>>>>>         self.coro = coro
       
    1:     def __call__(self, *args: Any, **kwargs: Any) -> _stream_wrapper:
>>>>>>         return _stream_wrapper(self.coro, args, kwargs)
       
       
    3: @payload_type(_stream_wrapper)
    2: class StreamWrapperPayload(Payload):
    1:     async def write(self, writer: AbstractStreamWriter) -> None:
>>>>>>         await self._value(writer)
       
    1:     def decode(self, encoding: str = "utf-8", errors: str = "strict") -> str:
>>>>>>         raise TypeError("Unable to decode.")
       
       
    3: @payload_type(streamer)
    2: class StreamPayload(StreamWrapperPayload):
    1:     def __init__(self, value: Any, *args: Any, **kwargs: Any) -> None:
>>>>>>         super().__init__(value(), *args, **kwargs)
       
    1:     async def write(self, writer: AbstractStreamWriter) -> None:
>>>>>>         await self._value(writer)
