    1:     def _fetch_stop_order_fallback(self, order_id: str, pair: str) -> CcxtOrder:
>>>>>>         params2 = {"stop": True, "ordType": "conditional"}
>>>>>>         for method in (
>>>>>>             self._api.fetch_open_orders,
>>>>>>             self._api.fetch_closed_orders,
>>>>>>             self._api.fetch_canceled_orders,
