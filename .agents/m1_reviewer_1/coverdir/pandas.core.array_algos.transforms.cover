    1: def shift(
>>>>>>     values: np.ndarray, periods: int, axis: AxisInt, fill_value: Scalar
>>>>>> ) -> np.ndarray:
  158:     new_values = values
       
  158:     if periods == 0 or values.size == 0:
>>>>>>         return new_values.copy()
       
           # make sure array sent to np.roll is c_contiguous
  158:     f_ordered = values.flags.f_contiguous
  158:     if f_ordered:
  158:         new_values = new_values.T
  158:         axis = new_values.ndim - axis - 1
       
  158:     if new_values.size:
  316:         new_values = np.roll(
  158:             new_values,
  158:             np.intp(periods),
  158:             axis=axis,
               )
       
  158:     axis_indexer = [slice(None)] * values.ndim
  158:     if periods > 0:
  158:         axis_indexer[axis] = slice(None, periods)
           else:
>>>>>>         axis_indexer[axis] = slice(periods, None)
  158:     new_values[tuple(axis_indexer)] = fill_value
       
           # restore original order
  158:     if f_ordered:
  158:         new_values = new_values.T
       
  158:     return new_values
