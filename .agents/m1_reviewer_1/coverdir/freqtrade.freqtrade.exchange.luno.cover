    1: import logging
       
    1: from freqtrade.exchange import Exchange
    1: from freqtrade.exchange.exchange_types import FtHas
       
       
    1: logger = logging.getLogger(__name__)
       
       
    3: class Luno(Exchange):
    1:     """
           Luno exchange class. Contains adjustments needed for Freqtrade to work
           with this exchange.
       
           Please note that this exchange is not included in the list of exchanges
           officially supported by the Freqtrade development team. So some features
           may still not work as expected.
           """
       
    1:     _ft_has: FtHas = {
    1:         "ohlcv_has_history": False,  # Only provides the last 1000 candles
    1:         "always_require_api_keys": True,  # Requires API keys to fetch candles
    1:         "trades_has_history": False,  # Only the last 24h are available
           }
