   12: class PairLock(ModelBase):
    1:     """
           Pair Locks database model.
           """
       
    1:     __tablename__ = "pairlocks"
    1:     session: ClassVar[SessionType]
       
    2:     id: Mapped[int] = mapped_column(primary_key=True)
       
    2:     pair: Mapped[str] = mapped_column(String(25), nullable=False, index=True)
           # lock direction - long, short or * (for both)
    2:     side: Mapped[str] = mapped_column(String(25), nullable=False, default="*")
    2:     reason: Mapped[str | None] = mapped_column(String(255), nullable=True)
