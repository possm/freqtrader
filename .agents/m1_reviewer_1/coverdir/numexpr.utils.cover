>>>>>>                 data.update(other)
                   else:
>>>>>>                 for k, v in other:
>>>>>>                     data[k] = v
       
>>>>>>         data.update(kwargs)
>>>>>>         self._context_data.set(data)
       
    1:     def keys(self):
>>>>>>         return self._context_data.get().keys()
       
    1:     def values(self):
>>>>>>         return self._context_data.get().values()
       
    1:     def items(self):
>>>>>>         return self._context_data.get().items()
       
