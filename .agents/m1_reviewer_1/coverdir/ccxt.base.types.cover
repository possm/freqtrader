       # Prediction-market structures (ccxt.prediction namespace).
       # Hierarchy: Event -> Market -> Outcome. The Outcome is the tradeable unit; there is
       # no `symbol` field — the handle is `outcome` ("MARKET:LABEL") and the raw exchange id
       # is `outcomeId`. Prices are probabilities 0..1, amounts are shares, costs are collateral.
    6: class PredictionFees(TypedDict):
    1:     trading: Num       # per-trade taker/maker rate (fraction, e.g. 0.02 = 2%)
    1:     resolution: Num    # fee taken from winnings at settlement (fraction)
       
       
   18: class PredictionOutcome(TypedDict):
    1:     info: dict[str, Any]
    1:     outcome: str         # unified handle "TRUMP_WIN_2024:YES" — round-trips; ex.outcomes key
    1:     outcomeId: Str       # raw exchange/on-chain id (token id / ticker / coin)
    1:     label: Str           # short human name "Yes"
    1:     market: Str          # parent market handle
    1:     marketId: Str
    1:     event: Str
    1:     price: Num           # probability 0..1
    1:     bid: Num
    1:     ask: Num
    1:     active: Bool
    1:     winner: Bool         # resolved True (the settleFraction == 1 case)
    1:     settleFraction: Num  # 0..1 fractional settlement
    1:     precision: Precision  # outcome-level price/amount precision
       
       
   35: class PredictionMarket(TypedDict):
    1:     info: dict[str, Any]
    1:     id: str              # raw exchange market id
    1:     market: str          # unified handle "TRUMP_WIN_2024"
    1:     event: Str
    1:     marketType: Str      # 'binary' | 'categorical' | 'scalar'
    1:     executionModel: Str  # 'clob' | 'amm' | 'parimutuel'
    1:     title: Str
    1:     description: Str
    1:     outcomes: list[PredictionOutcome]   # 1..N (categorical can be > 2)
    1:     underlying: Str      # scalar only
    1:     floorStrike: Num     # scalar only
    1:     capStrike: Num       # scalar only
    1:     strikeType: Str      # scalar only
    1:     collateral: Str      # quote currency symbol (USDC / USD1 / USD / ...)
    1:     active: Bool
    1:     closed: Bool
    1:     resolved: Bool
    1:     resolvedOutcome: Str       # winning outcome handle
    1:     settlementValue: Num       # scalar: the realized number
    1:     created: Int
    1:     createdDatetime: Str
    1:     end: Int
    1:     endDatetime: Str
    1:     volume: Num
    1:     liquidity: Num
    1:     openInterest: Num
    1:     tickSize: Num
    1:     limits: MarketLimits
    1:     fees: PredictionFees
    1:     resolutionSource: Str
    1:     image: Str
       
       
   24: class PredictionEvent(TypedDict):
