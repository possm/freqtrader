    1:         'docstropt': '    Optional arguments:',
    1:         'docstrout': '    Return objects:',
    1:         'docstrcbs': '    Call-back functions:',
    1:         'docreturn': '', 'docsign': '', 'docsignopt': '',
    1:         'latexdocstrreq': '\\noindent Required arguments:',
    1:         'latexdocstropt': '\\noindent Optional arguments:',
    1:         'latexdocstrout': '\\noindent Return objects:',
    1:         'latexdocstrcbs': '\\noindent Call-back functions:',
    1:         'routnote': {hasnote: '--- #note#', l_not(hasnote): ''},
    1:     }, {  # Function
    1:         'decl': '    #ctype# return_value = 0;',
    2:         'frompyobj': [
