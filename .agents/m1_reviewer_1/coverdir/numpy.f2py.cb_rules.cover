    1: def buildcallback(rout, um):
>>>>>>     from . import capi_maps
       
>>>>>>     outmess(f"    Constructing call-back function \"cb_{rout['name']}_in_{um}\"\n")
>>>>>>     args, depargs = getargs(rout)
