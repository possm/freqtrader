>>>>>>     if options is None:
>>>>>>         target_type = pa.types.lib.ensure_type(target_type)
>>>>>>         if safe is False:
>>>>>>             options = CastOptions.unsafe(target_type)
               else:
>>>>>>             options = CastOptions.safe(target_type)
>>>>>>     return call_function("cast", [arr], options, memory_pool)
       
       
