    1:     def populate_entry_trend(self, dataframe: DataFrame, metadata: dict) -> DataFrame:
               """
               Triggers long entry when ALL academic breakout conditions align:
               1. Price penetrates upper Donchian historical resistance.
               2. Price expands above Keltner ATR volatility boundary.
               3. Parkinson Volatility Ratio (PVR) confirms volatility regime expansion.
               4. Volume exceeds 20-period moving average by specified factor.
               5. Price trades above the structural trend EMA.
               6. Bitcoin macro gate is bullish (BTC > EMA200).
               7. Volume > 0 guard against illiquid / zero-volume bars.
               """
   55:         dataframe["enter_long"] = 0
   55:         dataframe["enter_tag"] = None
       
   55:         conditions = [
   55:             dataframe["close"] > dataframe["donchian_high"],
   55:             dataframe["close"] > dataframe["keltner_upper"],
   55:             dataframe["pvr"] > self.pvr_threshold.value,
   55:             dataframe["volume"] > (self.volume_factor.value * dataframe["volume_mean"]),
   55:             dataframe["close"] > dataframe["ema_trend"],
   55:             dataframe["btc_uptrend_1h"] == 1,
   55:             dataframe["volume"] > 0,
               ]
       
  110:         dataframe.loc[
  110:             np.logical_and.reduce(conditions),
   55:             ["enter_long", "enter_tag"]
   55:         ] = (1, "pvb_breakout")
       
   55:         return dataframe
       
