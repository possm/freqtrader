    "trailing_only_offset_is_reached": true,

    "telegram": {
        "enabled": false,
        "token": "",
        "chat_id": ""
    },

    "webhook": {
        "enabled": true,
        "url": "http://192.168.1.56:8123/api/webhook/freqtrade_exit_notification",
