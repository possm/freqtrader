{
    "max_open_trades": 10,
    "stake_currency": "EUR",
    "stake_amount": 75,
    "tradable_balance_ratio": 0.99,
    "fiat_display_currency": "EUR",
    "dry_run": true,
    "dry_run_wallet": 1500,
    "cancel_open_orders_on_exit": false,

    "trading_mode": "spot",
