# Freqtrade Central Environment Configuration Example
# Copy this file to .env and configure with your credentials.

# API Server Credentials & Security Tokens
FREQTRADE__api_server__jwt_secret_key=your_jwt_secret_key_here
FREQTRADE__api_server__ws_token=your_ws_token_here
FREQTRADE__api_server__username=freqtrader
FREQTRADE__api_server__password=freqtrader

# Exchange Credentials (Kraken Spot)
FREQTRADE__EXCHANGE__KEY=your_exchange_key_here
FREQTRADE__EXCHANGE__SECRET=your_exchange_secret_here

# Network Listen IP (WireGuard mesh IP default: 192.168.2.4)
LISTEN_IP=192.168.2.4
